<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Tahoma,Arial,sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
    radial-gradient(circle at 10% 10%,#ff149322,transparent 30%),
    radial-gradient(circle at 90% 20%,#8a2be222,transparent 30%),
    radial-gradient(circle at 50% 90%,#ff149315,transparent 35%),
    #07050a;

    color:white;
    overflow-x:hidden;
}

/* ===== NAVBAR ===== */

nav{
    position:fixed;
    top:0;
    left:0;
    right:0;
    z-index:999;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:16px 6%;

    background:#08060bcc;
    backdrop-filter:blur(20px);

    border-bottom:1px solid #ffffff12;
}

.logo{
    color:white;
    text-decoration:none;
    font-size:21px;
    font-weight:bold;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    color:#ddd;
    text-decoration:none;
    transition:.3s;
}

.nav-links a:hover{
    color:#ff5cad;
}

.menu{
    display:none;
    font-size:28px;
    cursor:pointer;
}

/* ===== HERO ===== */

.hero{
    min-height:100vh;

    display:flex;
    justify-content:center;
    align-items:center;

    text-align:center;

    padding:130px 20px 80px;

    position:relative;
}

.hero-content{
    max-width:900px;
}

.crown{
    font-size:80px;

    animation:float 3s ease-in-out infinite;
}

@keyframes float{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-15px);
    }

}

.hero h1{

    font-size:clamp(45px,9vw,90px);

    margin:20px 0;

    background:
    linear-gradient(
        90deg,
        #ff3d9a,
        #fff,
        #a855f7,
        #ff3d9a
    );

    background-size:300%;

    -webkit-background-clip:text;

    color:transparent;

    animation:gradient 5s linear infinite;
}

@keyframes gradient{

    0%{
        background-position:0%;
    }

    100%{
        background-position:300%;
    }

}

.hero p{

    color:#ddd;

    font-size:19px;

    line-height:2.3;
}

.buttons{

    margin-top:30px;

    display:flex;

    justify-content:center;

    gap:15px;

    flex-wrap:wrap;
}

.btn{

    display:inline-block;

    padding:15px 28px;

    border-radius:50px;

    color:white;

    text-decoration:none;

    font-weight:bold;

    transition:.3s;
}

.btn:hover{

    transform:
    translateY(-5px)
    scale(1.03);

}

.primary{

    background:
    linear-gradient(
        135deg,
        #ff2f92,
        #8338ec
    );

    box-shadow:
    0 15px 40px #ff2f9235;
}

.secondary{

    background:#ffffff08;

    border:1px solid #ffffff20;
}

/* ===== SECTIONS ===== */

section{
    padding:90px 6%;
}

.title{
    text-align:center;
    margin-bottom:50px;
}

.title h2{
    font-size:38px;
    margin-bottom:10px;
}

.title p{
    color:#999;
}

/* ===== GLASS ===== */

.glass{

    background:
    linear-gradient(
        145deg,
        #ffffff0b,
        #ffffff04
    );

    border:1px solid #ffffff12;

    border-radius:30px;

    backdrop-filter:blur(18px);

    box-shadow:
    0 25px 70px #00000045;
}

/* ===== ABOUT ===== */

.about{

    max-width:900px;

    margin:auto;

    padding:40px;

    text-align:center;

    line-height:2.4;
}

.about h2{

    font-size:30px;

    margin:15px;
}

.about .decor{

    color:#ff63b5;
}

/* ===== STATS ===== */

.stats{

    max-width:1000px;

    margin:40px auto;

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.stat{

    padding:30px;

    text-align:center;
}

.stat .big{

    font-size:40px;

    color:#ff5cac;

    margin-bottom:10px;
}

.stat span{
    color:#aaa;
}

/* ===== GALLERY ===== */

.gallery{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));

    gap:20px;
}

.photo{

    position:relative;

    height:300px;

    overflow:hidden;

    border-radius:25px;

    background:#111;

    border:1px solid #ffffff12;

    cursor:pointer;
}

.photo img{

    width:100%;
    height:100%;

    object-fit:cover;

    transition:.6s;
}

.photo:hover img{

    transform:scale(1.1);
}

.photo::after{

    content:"🍓";

    position:absolute;

    bottom:15px;

    right:15px;

    background:#0009;

    padding:8px 12px;

    border-radius:50px;
}

/* ===== VIDEOS ===== */

.videos{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

    gap:25px;
}

.video{

    overflow:hidden;

    border-radius:25px;
}

.video video{

    width:100%;

    display:block;

    background:#000;
}

.video-info{

    padding:20px;
}

.video-info h3{
    margin-bottom:8px;
}

.video-info p{
    color:#999;
}

/* ===== TELEGRAM ===== */

.telegram{

    max-width:800px;

    margin:auto;

    padding:50px 25px;

    text-align:center;
}

.telegram-icon{

    font-size:70px;

    margin-bottom:20px;
}

.telegram h2{

    font-size:clamp(22px,5vw,36px);

    margin-bottom:20px;
}

.members{

    display:inline-block;

    padding:10px 22px;

    border-radius:50px;

    background:#ff4fa315;

    margin-bottom:30px;
}

.members strong{

    color:#ff65b5;

    font-size:25px;
}

.description{

    line-height:2.4;

    margin-bottom:30px;
}

.description .decor{
    color:#ff65b5;
}

.telegram-button{

    display:inline-block;

    padding:16px 35px;

    border-radius:50px;

    color:white;

    text-decoration:none;

    font-weight:bold;

    background:
    linear-gradient(
        135deg,
        #ff3297,
        #853cff
    );

    box-shadow:
    0 15px 40px #ff329735;

    transition:.3s;
}

.telegram-button:hover{

    transform:
    translateY(-5px)
    scale(1.04);
}

/* ===== FOOTER ===== */

footer{

    padding:40px 20px;

    text-align:center;

    color:#777;

    border-top:
    1px solid #ffffff0d;
}

footer strong{
    color:#ff5cae;
}

/* ===== MOBILE ===== */

@media(max-width:768px){

    .menu{
        display:block;
